# === Обязательные настройки Telegram ===
# Токен вашего бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата, группы или канала (например: 123456789 или -1001234567890)
TELEGRAM_CHAT_ID=your_chat_id_here

# (Опционально) ID топика/ветки, если отправка идет в супергруппу с темами
TELEGRAM_THREAD_ID=

# === Настройки сервера и расписания ===
# Имя сервера, которое будет отображаться в отчете
SERVER_NAME=My-Production-Server

# Часовой пояс контейнера (например: Asia/Almaty, Europe/Moscow, UTC)
TZ=Asia/Almaty

# Время ежедневной отправки логов (формат ЧЧ:ММ по часовому поясу TZ)
SEND_TIME=09:00

# Отправить ли отчет сразу при запуске контейнера (true / false)
RUN_ON_STARTUP=true

# === Настройки сбора и формата логов ===
# За сколько последних часов собирать логи (0 = за всё время работы контейнера)
LOG_HOURS=24

# Лимит последних строк на каждый контейнер ("all" = все строки за период, или число, например 5000)
LOG_TAIL=all

# Режим отправки в Telegram:
#   files — сводка + отдельный .log файл для каждого контейнера (по умолчанию)
#   zip   — сводка + один общий .zip архив со всеми логами
#   text  — сводка + логи текстовыми сообщениями прямо в чат
SEND_MODE=files

# Исключать ли сам контейнер логгера из отчета (true / false)
EXCLUDE_SELF=true

# Список имен контейнеров через запятую, которые не нужно логировать (например: portainer,watchtower)
EXCLUDE_CONTAINERS=
